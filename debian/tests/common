#!/bin/sh
set -eu

python3 - <<'PY'
import chimera
import chimera.errors
import chimera.models
import chimera.runtime
import chimera.tls
import chimera.endpoint

print("common-imports", chimera.__version__, chimera.__file__)
PY
test ! -e /usr/bin/chimeractl
test ! -e /usr/bin/chimera-server
test ! -e /usr/lib/systemd/system/chimera-server.service
test ! -e /etc/chimera-spawn/chimera.yaml
if dpkg -s chimera-spawn-server >/dev/null 2>&1; then
    echo "python3-chimera-spawn must not pull chimera-spawn-server" >&2
    exit 1
fi
python3 - <<'PY'
import subprocess

depends = subprocess.check_output(
    ["dpkg-query", "-W", "-f", "${Depends}", "python3-chimera-spawn"],
    text=True,
)
for forbidden in (
    "python3-aiohttp",
    "python3-dbus-next",
    "python3-watchfiles",
    "python3-httpx",
    "python3-websockets",
    "python3-typer",
    "python3-jinja2",
    "systemd-container",
    "adduser",
):
    assert forbidden not in depends, depends
print("common-depends-ok")
PY
